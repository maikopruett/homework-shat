{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homework-shat",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
